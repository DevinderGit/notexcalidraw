# Desktop build mode (D-14).
#
# Loaded by Vite when the mode is "desktop" — that is, for the webapp build
# that the Electron shell serves, and for the `yarn desktop:dev` dev server.

# Marks the build as a desktop build. The renderer bootstrap reads this to
# decide whether to load the desktop glue (D-16).
VITE_APP_DESKTOP="true"

# No service worker in the desktop app: the app is already local, and a
# service worker would cache assets outside the toolchain's control and
# complicate the CSP (PU 5.6).
VITE_APP_ENABLE_PWA="false"

# No analytics in the desktop build.
VITE_APP_ENABLE_TRACKING="false"

# NOTE: no VITE_APP_SENTRY_DSN here — upstream Sentry init is DSN-gated and
# stays off. Do NOT edit excalidraw-app/sentry.ts (outside the 0.3 budget).
